<Window x:Class="RadioPulseViewer.PublicGraphRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公開グラフ記録 - RadioPulse Viewer"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#175CD3" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7DCE2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel>
                <TextBlock Text="公開グラフの値を記録"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="検索ページは参照表示だけに使用します。HTML・DOM・通信レスポンスの解析や自動操作は行わず、画面で確認した件数だけを入力して保存します。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="検索語"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="QueryTextBox"
                     Grid.Column="1"
                     Height="34"
                     VerticalContentAlignment="Center"
                     ToolTip="番組名、出演者名、またはハッシュタグ" />

            <TextBlock Grid.Column="3"
                       Text="表示期間"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="RangeComboBox"
                      Grid.Column="4"
                      Height="34"
                      SelectedIndex="1">
                <ComboBoxItem Content="6時間" Tag="6h" />
                <ComboBoxItem Content="24時間" Tag="24h" />
                <ComboBoxItem Content="7日" Tag="7d" />
                <ComboBoxItem Content="30日" Tag="30d" />
            </ComboBox>

            <Button Grid.Column="6"
                    Content="参照ページを開く"
                    Click="OpenSourceButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="時系列データ"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,7"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="1行につき『表示ラベル, 件数』で入力します。例: 8/3 19:00, 125" />
                    <TextBox x:Name="PointInputTextBox"
                             Height="145"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="合計件数"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,7"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="合計だけを記録する場合は、この欄だけ入力できます。空欄の場合は時系列データの合計を使用します。" />
                    <TextBox x:Name="TotalCountTextBox"
                             Height="34"
                             VerticalContentAlignment="Center" />

                    <TextBlock Margin="0,14,0,4"
                               Text="メモ"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="NoteTextBox"
                             Height="61"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="プレビュー"
                                Click="PreviewButton_Click" />
                        <Button Content="CSVへ保存"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="14,11,14,8">
                    <TextBlock Text="記録内容のプレビュー"
                               FontSize="17"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left" />
                    <TextBlock x:Name="SummaryTextBlock"
                               Text="値を入力してプレビューしてください。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextAlignment="Right" />
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              Padding="14,0,14,14"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PreviewItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <Grid Grid.Column="1" Height="22" Margin="0,0,12,0">
                                        <Border Background="#F2F4F7" CornerRadius="4" />
                                        <Border Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="4"
                                                ToolTip="{Binding ToolTip}" />
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CountText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="準備中..."
                           TextWrapping="Wrap" />
                <TextBlock x:Name="HistoryPathTextBlock"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="CSV保存先を開く"
                    Click="OpenHistoryFolderButton_Click" />
            <Button Grid.Column="2"
                    Content="閉じる"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
