<Window x:Class="RadioPulseViewer.XPostCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公式X投稿数分析 - RadioPulse Viewer"
        Width="920"
        Height="700"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#175CD3" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#EAF2FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7DCE2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#EFF8FF"
                BorderBrush="#B2DDFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel>
                <TextBlock Text="公式X APIによる投稿数取得"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="X API v2 の投稿数エンドポイントだけを利用します。Yahoo! JAPANやXのWebページはスクレイピングせず、投稿本文・利用者情報・画像も取得しません。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="検索語"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="QueryTextBox"
                     Grid.Column="1"
                     Height="34"
                     VerticalContentAlignment="Center"
                     ToolTip="番組名、出演者名、またはハッシュタグ。X APIの検索クエリも使用できます。" />

            <TextBlock Grid.Column="3"
                       Text="期間"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="RangeComboBox"
                      Grid.Column="4"
                      Height="34"
                      SelectedIndex="1">
                <ComboBoxItem Content="過去6時間" Tag="6h" />
                <ComboBoxItem Content="過去24時間" Tag="24h" />
                <ComboBoxItem Content="過去7日" Tag="7d" />
            </ComboBox>

            <Button x:Name="FetchButton"
                    Grid.Column="6"
                    Content="投稿数を取得"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="FetchButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="合計投稿数"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="TotalCountTextBlock"
                               Text="-"
                               Margin="0,4,0,0"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="取得条件"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="SummaryTextBlock"
                               Text="検索語と期間を指定してください。"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="14,11,14,8">
                    <TextBlock Text="投稿数の推移"
                               FontSize="17"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="6・24時間は1時間単位、7日は1日単位"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              Padding="14,0,14,14"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CountItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />

                                    <Grid Grid.Column="1" Height="22" Margin="0,0,12,0">
                                        <Border Background="#F2F4F7" CornerRadius="4" />
                                        <Border Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="4"
                                                ToolTip="{Binding ToolTip}" />
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CountText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="準備中..."
                           TextWrapping="Wrap" />
                <TextBlock x:Name="HistoryPathTextBlock"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="CSV保存先を開く"
                    Click="OpenHistoryFolderButton_Click" />
            <Button Grid.Column="2"
                    Content="閉じる"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
