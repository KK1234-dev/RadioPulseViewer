<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Windows x64 アプリとして固定 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <!-- ビルド時に RadioPulseViewer.exe を必ず生成する -->
    <UseAppHost>true</UseAppHost>
    <SelfContained>false</SelfContained>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AssemblyName>RadioPulseViewer</AssemblyName>
    <RootNamespace>RadioPulseViewer</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Keisuke Katahira</Authors>
    <Copyright>Copyright (c) 2026 Keisuke Katahira</Copyright>
    <Description>Weekly radio schedule and real-time reaction viewer for Windows.</Description>

    <!-- 出力先を bin\Debug / bin\Release 配下へ統一 -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\programs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
